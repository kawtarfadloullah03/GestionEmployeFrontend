terraform-gcp/crash.log

# Python
__pycache__/
*.pyc
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/

# Docker
*.log

# Secrets / environment files
.env
backend/.env
frontend/.env
backend/*.db
backend/output/*
!backend/output/.gitkeep
