# Copy this file to backend/.env (gitignored) and fill in the real values.
# Loaded automatically by backend/config.py via python-dotenv.
# Without these values the API still starts: Mongo falls back to the
# in-memory seed store and the chatbot uses built-in offline answers.

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=GestionEmploye

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Chatbot (OpenRouter free ":free" models) ──────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Optional fallback - Hugging Face Inference Providers free credits
# HF_TOKEN=
# HF_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507
